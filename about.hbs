<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>CayenChat third-party licenses</title>
</head>
<body>
<h1>CayenChat third-party licenses</h1>
<p>CayenChat is built with the Rust crates below. Each is listed with the
license text and copyright notices it is distributed under.</p>
<h2>Licenses in use</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<hr>
<h2 id="{{id}}">{{name}}</h2>
<h3>Used by:</h3>
<ul>
{{#each used_by}}
<li>{{crate.name}} {{crate.version}}{{#if crate.repository}} (<a href="{{crate.repository}}">{{crate.repository}}</a>){{/if}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
